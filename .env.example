# Copy this file to .env and fill in. NEVER commit .env.
PORT=5000

# ---- AI planner (optional). Set ONE of the two keys; with neither, a simple rules engine runs instead. ----
# Option A: Google Gemini (free key from aistudio.google.com, rate-limited)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Option B: Anthropic Claude (paid API key from console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only needed if BOTH keys are set and you want to choose: gemini or anthropic (default is Claude first)
AI_PROVIDER=

# Optional: if set, POST /api/campus/ingest requires header  x-api-key: <this value>
# Leave empty for the hackathon demo so the browser Sensor Test tab works.
INGEST_API_KEY=
